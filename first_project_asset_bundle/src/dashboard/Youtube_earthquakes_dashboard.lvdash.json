{
  "datasets": [
    {
      "name": "92f5a8b0",
      "displayName": "EqrthQuake_detail",
      "queryLines": [
        "select * from silver.earthquake_data_final"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    },
    {
      "name": "ddbc4db2",
      "displayName": "Earthquake_type",
      "queryLines": [
        "select count(*) as total_magnitude_bucket\r\n",
        ",magnitude_bucket from(\r\n",
        "    select case when mag<2 then'Micro (<2)'\r\n",
        "    when mag between 2 and 3 then 'Minor (2-3)'\r\n",
        "    when mag between 3 and 4 then 'Light (3-4)'\r\n",
        "    when mag between 4 and 5 then 'Moderate (4-5)'\r\n",
        "    when mag between 5 and 6 then 'Strong (5-6)'\r\n",
        "    when mag between 6 and 7 then 'Major (6-7)'\r\n",
        "    when mag between 7 and 8 then 'Great (7-8)'\r\n",
        "    when mag >8 then 'Meteoric (>8)' end as magnitude_bucket\r\n",
        "    from silver.earthquake_data_final\r\n",
        ")\r\n",
        "group by magnitude_bucket"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    },
    {
      "name": "58b7ee04",
      "displayName": "Top Affected Locations",
      "queryLines": [
        "select count(*) as event_count,\r\n",
        "case when size(split(place,\", \")) = 1 then split(place,\",\")[0]\r\n",
        "else split(place,\", \")[1]\r\n",
        "end as country\r\n",
        "from(\r\n",
        "select \r\n",
        "time,\r\n",
        "title,\r\n",
        "longitude,\r\n",
        "latitude,\r\n",
        "place\r\n",
        "from silver.earthquake_data_final)\r\n",
        "group by country"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    }
  ],
